# Cloudflare Pages 静态资源缓存策略：图片/视频内容不常变更，浏览器缓存一天，
# 减少重复访问时对每张图的回源校验（替换同名文件后最多 24h 生效）
/images/*
  Cache-Control: public, max-age=86400

/videos/*
  Cache-Control: public, max-age=86400

# 根目录下的封面与视频（CDN 失败时的站内回退路径，同样需要缓存）
/jobhunter-demo.mp4
  Cache-Control: public, max-age=86400

/wandercity-demo.mp4
  Cache-Control: public, max-age=86400

/jobhunter-cover.jpg
  Cache-Control: public, max-age=86400

/wandercity-cover.png
  Cache-Control: public, max-age=86400
