# Gemini AI（原有配置）
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ---------------------------------------------------------------------------
# 留言板后端 —— 部署到 Vercel 时在 Dashboard → Settings → Environment Variables
# 配置以下三项（本地开发可复制本文件为 .env，server.ts 会自动加载）
# ---------------------------------------------------------------------------

# Upstash Redis REST API：Vercel Marketplace 创建 Upstash Redis 存储后自动注入，
# 或在 Upstash 控制台复制 REST URL / REST Token。未配置时后端降级为内存存储（仅限本地联调）
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# 留言板管理员密码（遮罩角落 🔑 入口登录用；未配置时管理员登录始终失败）
ADMIN_PASSWORD=""
